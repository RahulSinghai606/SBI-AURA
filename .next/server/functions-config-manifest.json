{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image).*)"
        }
      ]
    },
    "/api/agents/run": {
      "maxDuration": 60
    },
    "/api/chat": {
      "maxDuration": 60
    },
    "/api/pii": {
      "maxDuration": 30
    },
    "/api/sbi/balance": {
      "maxDuration": 30
    },
    "/api/sbi/execute": {
      "maxDuration": 30
    },
    "/api/sbi/twin": {
      "maxDuration": 30
    },
    "/api/tts": {
      "maxDuration": 30
    }
  }
}