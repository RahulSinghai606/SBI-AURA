# Azure AI Foundry — Responses API endpoint (server-side only, never exposed to the browser)
AZURE_AI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses
AZURE_AI_KEY=<your-key>
AZURE_AI_DEPLOYMENT=<your-deployment-name>

# Azure Cognitive (Speech / Translator / Language) — same key as above
AZURE_COG_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_SPEECH_REGION=eastus

# SBI InnoHub banking APIs
SBI_API_BASE=https://api.innohub.sbi
SBI_API_TOKEN=<your-x-authorization-bearer-token>
# Data source: live | mock | auto
#   live = InnoHub sandbox only
#   mock = schema-faithful mock only (use while SBI endpoints are being enabled)
#   auto = try live, fall back to last-good cache, then to the schema mock
SBI_MODE=mock

# Gate the demo behind a shared password
SITE_PASSWORD=<choose-a-password>
